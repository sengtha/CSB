[Unit]
Description=Run the CSB chain health report every 15 minutes

[Timer]
OnBootSec=3min
# 15 minutes, not 5. Nothing here reacts to anything, so a tighter interval only
# adds journal noise. The signal it exists to catch — a validator's P-Chain fee
# balance draining — moves over days.
OnUnitActiveSec=15min
AccuracySec=1min
Unit=csb-watchdog.service

[Install]
WantedBy=timers.target
