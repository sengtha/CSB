[Unit]
Description=CSB chain health report (one-shot, driven by csb-watchdog.timer)
After=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
# Point at the current chain. Update these if the L1 is redeployed.
Environment=CSB_RPC_URL=http://127.0.0.1:9650/ext/bc/299jCTH4ErmwFMB3ZKa18Ck9EDzc99DMD48zkszxcArpaUfTqW/rpc
Environment=CSB_HEALTH_PORT=9650
Environment=CSB_SUBNET_ID=fgNiKVRTRJFZbCzSUPJMix6YdG2HfpXGf1LP9rQ58b5TU9mJL
# Warn when a validator's P-Chain fee balance drops below this many AVAX.
Environment=CSB_MIN_VALIDATOR_BALANCE=0.25
ExecStart=/usr/local/bin/csb-watchdog

# There is deliberately no restart switch. This unit reports and exits; a
# non-zero exit marks the service failed, which is what journal alerting reads.
# See the header of ops/csb-watchdog.sh for why automatic restarts were removed.
