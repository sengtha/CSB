# CSB Docker validator config (docker-compose.validator.yml reads this file).
# TESTNET — these are PUBLIC network identifiers, not secrets. Do NOT put any
# private key / passcode here (those live in systemd env + app/deployments.json).
#
# Runs as validator #2 on the SAME VM as the avalanche-cli bootstrap node, so it
# uses different ports (9652/9653) than the bootstrap node (9650/9651).

# --- CSB L1 identity (from: avalanche blockchain describe csb) ---
# Current chain. If you REDEPLOY the L1, update CSB_SUBNET_ID with the new value
# (the VM ID stays the same — it's derived from the "csb" VM name).
CSB_SUBNET_ID=FWHGBo9oxEN6HEsFp6Ajm5BMGihoKMfXk81t7zFirhAUybJxw
CSB_VM_ID=koLRzStcoE4fZ6V1DtXJCYMVWctdrdfpR6Y5egzFbURXRSvVv

AVAGO_NETWORK_ID=fuji

# --- ports: distinct from the bootstrap node on 9650/9651 ---
VALIDATOR_API_PORT=9652
VALIDATOR_P2P_PORT=9653

# --- version pair (must match the chain: protocol 44) ---
AVALANCHEGO_VERSION=v1.14.1
SUBNET_EVM_VERSION=0.8.0
