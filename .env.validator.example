# Copy to .env next to docker-compose.validator.yml and fill in.

# Subnet ID of the CSB L1 — the network this validator tracks.
# Provided by the chain coordinator (from: avalanche blockchain describe csb).
CSB_SUBNET_ID=

# VM ID of the CSB blockchain (baked into the image as the plugin filename).
# Provided by the chain coordinator.
CSB_VM_ID=srEXiWaHuhNyGwPUi444Tu47ZEDwxTWrbQiuD7FmgSAQ6X7Dy

# Avalanche network the L1 is anchored to: fuji (testnet) or mainnet.
AVAGO_NETWORK_ID=fuji

# Node ports. Defaults are fine for a single validator per machine.
# Running BOTH a fuji and a mainnet validator on one machine: give the second
# one different ports (e.g. 9652/9653) and open its P2P port in the firewall.
VALIDATOR_API_PORT=9650
VALIDATOR_P2P_PORT=9651

# Version pair — check the subnet-evm/avalanchego compatibility table before bumping.
AVALANCHEGO_VERSION=v1.13.3
SUBNET_EVM_VERSION=0.7.6
